<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--标题-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="图书馆图书管理系统"
            android:textSize="30sp"
            android:gravity="center"
            android:textColor="#222222"
            android:layout_marginBottom="24dp"/>

        <!--图书1 红楼梦-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="10dp"
            android:padding="12dp"
            android:background="#FFFFFF">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/book1_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="红楼梦"
                    android:textSize="20sp"
                    android:textColor="#000000"/>
                <TextView
                    android:id="@+id/book1_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="作者：曹雪芹"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/book1_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简介：古典长篇小说四大名著之首"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/book1_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="库存：3本"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/book1_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="状态：可借阅"
                    android:textSize="14sp"/>
            </LinearLayout>
            <Button
                android:id="@+id/btn_borrow1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="借阅"/>
            <Button
                android:id="@+id/btn_return1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="归还"/>
        </LinearLayout>

        <!--图书2 西游记-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="10dp"
            android:padding="12dp"
            android:background="#FFFFFF">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/book2_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="西游记"
                    android:textSize="20sp"
                    android:textColor="#000000"/>
                <TextView
                    android:id="@+id/book2_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="作者：吴承恩"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/book2_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简介：经典神魔小说"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/book2_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="库存：2本"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/book2_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="状态：可借阅"
                    android:textSize="14sp"/>
            </LinearLayout>
            <Button
                android:id="@+id/btn_borrow2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="借阅"/>
            <Button
                android:id="@+id/btn_return2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="归还"/>
        </LinearLayout>

        <!--图书3 三体-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="10dp"
            android:padding="12dp"
            android:background="#FFFFFF">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/book3_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="三体"
                    android:textSize="20sp"
                    android:textColor="#000000"/>
                <TextView
                    android:id="@+id/book3_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="作者：刘慈欣"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/book3_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简介：长篇科幻小说"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/book3_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="库存：4本"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/book3_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="状态：可借阅"
                    android:textSize="14sp"/>
            </LinearLayout>
            <Button
                android:id="@+id/btn_borrow3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="借阅"/>
            <Button
                android:id="@+id/btn_return3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="归还"/>
        </LinearLayout>

        <!--图书4 平凡的世界【新增】-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="10dp"
            android:padding="12dp"
            android:background="#FFFFFF">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/book4_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="平凡的世界"
                    android:textSize="20sp"
                    android:textColor="#000000"/>
                <TextView
                    android:id="@+id/book4_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="作者：路遥"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/book4_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简介：现实主义长篇文学作品"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/book4_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="库存：3本"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/book4_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="状态：可借阅"
                    android:textSize="14sp"/>
            </LinearLayout>
            <Button
                android:id="@+id/btn_borrow4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="借阅"/>
            <Button
                android:id="@+id/btn_return4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="归还"/>
        </LinearLayout>

        <!--分割线-->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#AAAAAA"
            android:layout_marginVertical="20dp"/>

        <!--统计信息区域-->
        <TextView
            android:id="@+id/total_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:gravity="center"/>

        <!--操作日志区域-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📜操作记录："
            android:textSize="18sp"
            android:layout_marginTop="16dp"/>
        <TextView
            android:id="@+id/log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="#FFFFFF"/>

        <!--功能按钮-->
        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重置所有图书库存"
            android:layout_marginTop="16dp"/>
        <Button
            android:id="@+id/btn_clear_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清空操作日志"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
