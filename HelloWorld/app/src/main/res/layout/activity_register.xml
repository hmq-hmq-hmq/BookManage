<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="32dp" android:gravity="center">
    <EditText android:id="@+id/et_reg_username" android:layout_width="match_parent" android:layout_height="50dp" android:hint="输入新账号" android:layout_marginBottom="16dp"/>
    <EditText android:id="@+id/et_reg_password" android:layout_width="match_parent" android:layout_height="50dp" android:hint="输入新密码" android:inputType="textPassword" android:layout_marginBottom="16dp"/>
    <Button android:id="@+id/btn_reg_submit" android:layout_width="match_parent" android:layout_height="50dp" android:text="提交注册"/>
    <Button android:id="@+id/btn_back_login" android:layout_width="match_parent" android:layout_height="50dp" android:text="返回登录" android:layout_marginTop="8dp"/>
</LinearLayout>